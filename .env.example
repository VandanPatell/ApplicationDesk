# Copy to .env in the project root. Never commit real credentials.
APP_ORIGIN=http://localhost:8080
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=

# Optional AI (leave model/key blank for profile-based drafting only)
AI_PROVIDER=openai-compatible
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=
AI_API_KEY=
# Optional job sources (Remotive and Hacker News need no API key)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in
JSEARCH_API_KEY=
# Optional local workspace authentication. Single-quote a hash containing dollar signs.
# Generate interactively: node backend/scripts/hash-password.mjs
APP_PASSWORD_HASH=
APP_SESSION_SECRET=

# Scheduler timezone (browser dates use the browser timezone)
TZ=Asia/Kolkata
